        "mysql_mcp_server"
      ],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "Dz2911##",
        "MYSQL_DATABASE": "rahulshettyacademy"
      }
    },
    "rest_api": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "dkmaker-mcp-rest-api"
      ],
      "env": {
        "REST_BASE_URL": "https://rahulshettyacademy.com"
      }
    }
  }
}